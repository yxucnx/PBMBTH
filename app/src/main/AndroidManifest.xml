<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Discord sign-in in the Discord app (GameActivity.openInDiscordApp): Android 11+ hides other apps without this -->
    <queries>
        <package android:name="com.discord" />
    </queries>

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".GameApp"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/appName"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".GameActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Discord's redirect back into the app (https://shootingpoint.xyz/?code=...). Off by default: GameActivity turns it on only while
             a sign-in is out in the Discord app, so a phone browser's own Discord sign-in is never pulled into the app. The domain is
             verified by https://shootingpoint.xyz/.well-known/assetlinks.json (this package + the release key). -->
        <activity-alias
            android:name=".DiscordReturn"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".GameActivity">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="shootingpoint.xyz" android:path="/" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
